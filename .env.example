# Copy to .env (root) — values are read by docker-compose and by services that load this file.
# Per-service overrides live in apps/web/.env.local and services/*/.env.

# ---- Database (Postgres) ----
POSTGRES_USER=webbwatch
POSTGRES_PASSWORD=webbwatch_dev_password
POSTGRES_DB=webbwatch
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://webbwatch:webbwatch_dev_password@postgres:5432/webbwatch

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---- Object storage: Azure Blob (Azurite locally) ----
# `UseDevelopmentStorage=true` is the canonical SDK shortcut for "talk to the local
# Azurite emulator on 127.0.0.1 using the well-known dev account". No literal key in
# this file (GitHub secret scanning would flag it — it's a known false positive).
# Docs: https://learn.microsoft.com/azure/storage/common/storage-use-azurite#well-known-storage-account-and-key
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_ACCOUNT=devstoreaccount1
AZURE_BLOB_CONTAINER_FITS=webbwatch-fits
AZURE_BLOB_CONTAINER_PREVIEWS=webbwatch-previews
#
# When services run inside Docker Compose, they reach Azurite at host `azurite`, not
# 127.0.0.1, so the shortcut doesn't apply. Use the full connection string instead —
# look up the Azurite "well-known storage account and key" page (linked above) and
# paste it into a LOCAL `.env` (not this committed example). The key is published by
# Microsoft and is only valid against the emulator.
#
# In prod (Container Apps), drop the connection string entirely and set:
#   AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# then let azure-identity.DefaultAzureCredential() pick up the managed identity.

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- MAST / archive ----
MAST_API_TOKEN=

# ---- JWST public source on AWS (anonymous read; no AWS account required) ----
JWST_S3_BUCKET=stpubdata
JWST_S3_PREFIX=jwst/
JWST_S3_REGION=us-east-1
JWST_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:879230861493:stpubdata/jwst
# Webhook URL we register with AWS SNS so JWST notifications land on our Azure-hosted API.
# Locally this stays unset; in prod set to the public Container Apps URL.
JWST_SNS_WEBHOOK_URL=

# ---- Cloud AI (dual-provider: openai | azure_openai) ----
AI_PROVIDER=openai

# OpenAI direct
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Azure OpenAI Service
# Endpoint is the resource URL, e.g. https://my-webbwatch-aoai.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
# Deployment names you've created in the Azure portal (NOT the underlying model id):
AZURE_OPENAI_DEPLOYMENT_CHAT=gpt-4.1-mini
AZURE_OPENAI_DEPLOYMENT_VISION=gpt-4.1-mini
# In prod prefer managed identity over a key:
#   AZURE_OPENAI_USE_MANAGED_IDENTITY=true

# ---- Local AI (Ollama, OpenAI-compatible endpoint) ----
# Ollama is yours to install + run (https://ollama.com). The worker pings it per
# job and no-ops if unreachable; LOCAL_AI_ENABLE gates enqueue so sessions without
# Ollama don't accumulate failure rows. Pull the model first:
#   ollama pull llama3.1:8b-instruct-q4_K_M
# Base URL MUST end in /v1 (Ollama's OpenAI-compatible path). From inside Docker
# Compose reach the host's Ollama via host.docker.internal; for no-Docker dev use
# http://localhost:11434/v1.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_AI_ENABLE=false
LOCAL_AI_MODEL=llama3.1:8b-instruct-q4_K_M
# Vision (Phase 5.5) is opt-in + on-demand ("Generate vision summary" button).
# llava:7b fits 8 GB; llama3.2-vision:11b is better on >=12 GB. Pull it first:
#   ollama pull llava:7b
LOCAL_AI_VISION_ENABLE=false
LOCAL_AI_VISION_MODEL=llava:7b
LOCAL_AI_MAX_TOKENS=1024
LOCAL_AI_TEMPERATURE=0.2
LOCAL_AI_REQUEST_TIMEOUT_SECONDS=120

# ---- App ----
ENVIRONMENT=development
LOG_LEVEL=INFO
