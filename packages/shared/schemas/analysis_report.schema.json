{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webbwatch.ai/schemas/analysis_report.schema.json",
  "title": "AnalysisReport",
  "description": "Output of a deterministic/local/cloud analysis run over a single JWST data product. See plan §7.",
  "type": "object",
  "required": [
    "product_id",
    "analysis_run_id",
    "analysis_mode",
    "summary",
    "measured_facts",
    "interesting_features",
    "quality_flags",
    "recommended_next_steps",
    "human_validation_required",
    "tags",
    "model_notes"
  ],
  "properties": {
    "product_id": { "type": "string" },
    "analysis_run_id": { "type": "string" },
    "analysis_mode": { "type": "string", "enum": ["local", "cloud", "hybrid", "deterministic"] },
    "summary": { "type": "string" },
    "measured_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "source"],
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "string" },
          "source": { "type": "string", "enum": ["metadata", "header", "computed"] }
        }
      }
    },
    "interesting_features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["feature", "evidence", "confidence"],
        "properties": {
          "feature": { "type": "string" },
          "evidence": { "type": "string" },
          "confidence": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    },
    "quality_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["flag", "severity"],
        "properties": {
          "flag": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
          "details": { "type": "string" }
        }
      }
    },
    "recommended_next_steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "human_validation_required": { "type": "boolean" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "model_notes": {
      "type": "object",
      "required": ["model", "prompt_version", "created_at"],
      "properties": {
        "model": { "type": "string" },
        "prompt_version": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
